# Application
PORT=8080
GIN_MODE=debug

# Database - switch between sqlite and postgres
# Local dev: use sqlite (no setup required)
DB_DRIVER=sqlite
DB_DSN=file:./dev.db

# PostgreSQL (used by Docker Compose - switch DB_DRIVER=postgres to use)
# DB_DRIVER=postgres
# DB_DSN=host=localhost user=storefront password=storefront dbname=storefront port=5432 sslmode=disable

# Redis (optional - caches hot product lists for 5 minutes)
# Leave empty to disable caching
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=change-me-in-production-use-a-long-random-string

# CORS - comma-separated allowed origins (* for dev)
CORS_ALLOWED_ORIGINS=*
